# Copy this to .env and fill in values
NODE_ENV=development
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
# Get a FREE Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Frontend origin allowed by CORS (set to your Vercel URL in production)
FRONTEND_URL=https://study-mate-ai-dun.vercel.app

# Optional but recommended for production: Neon/Postgres connection string.
# Example: postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=
# Leave PGSSL unset for Neon. Set PGSSL=disable only for a local Postgres without SSL.
# PGSSL=disable
